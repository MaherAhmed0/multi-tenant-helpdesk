PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=multi_tenant_helpdesk

REDIS_URL=replace_with_protocol_host_port

MIGRATION_DATABASE_USER=helpdesk_migrator
MIGRATION_DATABASE_PASSWORD=replace_with_local_migrator_password

DATABASE_USER=helpdesk_app
DATABASE_PASSWORD=replace_with_local_password

SESSION_COOKIE_SECURE=false

# Replace locally with a cryptographically random secret of at least 32 bytes.
CSRF_SECRET=<replace_me>

# Must be standard Base64 encoding of exactly 32 cryptographically random bytes.
TOTP_ENCRYPTION_KEY=<replace_me>
